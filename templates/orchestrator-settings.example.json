{
  "_comment": "Example orchestrator settings — copy to ~/.claude/orchestrator-settings.json. Only override the keys you care about; defaults live in orchestrator/config.py:_SETTINGS_DEFAULTS, which also carries the comment explaining each one. GENERATED by configs/scripts/regen-settings-example.py — edit _SETTINGS_DEFAULTS instead. Never commit this file with real secrets.",
  "max_workers": 0,
  "auto_start": true,
  "auto_push": true,
  "auto_merge": true,
  "auto_merge_strategy": "auto",
  "auto_review": true,
  "default_model": "sonnet",
  "loop_supervisor_model": "sonnet",
  "loop_convergence_k": 2,
  "loop_convergence_n": 3,
  "loop_max_iterations": 20,
  "loop_context_mode": "carry",
  "worker_structured_output": true,
  "worker_require_worktree": true,
  "worker_git_surface_guard": true,
  "worker_checkpoint_shadow": true,
  "run_budget_usd": 0.0,
  "run_budget_tokens": 0,
  "auto_oracle": false,
  "phase_graph_validate": false,
  "judge_diversity_enabled": false,
  "judge_diversity_block": false,
  "repro_test_gate": false,
  "auto_model_routing": false,
  "verifier_cascade_enabled": false,
  "verifier_cascade_min_score": 80,
  "verifier_cascade_max_files": 8,
  "verifier_cascade_task_types": [
    "test",
    "tldr"
  ],
  "context_budget_warning": true,
  "github_issues_sync": false,
  "github_issues_label": "orchestrator",
  "agent_teams": false,
  "stuck_timeout_minutes": 15,
  "cost_budget": 0,
  "worker_token_budget": 0,
  "worker_env_deny": [
    "*_API_KEY",
    "*_APIKEY",
    "*_SECRET",
    "*_SECRET_*",
    "*_TOKEN",
    "*_PASSWORD",
    "*_CREDENTIALS",
    "*_PRIVATE_KEY",
    "AWS_*",
    "GOOGLE_*",
    "GCP_*",
    "AZURE_*"
  ],
  "worker_env_allow": [
    "GH_TOKEN",
    "GITHUB_TOKEN"
  ],
  "notification_webhook": "",
  "auto_scale": false,
  "min_workers": 1,
  "webhook_secret": "",
  "webhook_allow_unauthenticated": false,
  "coverage_scan": false,
  "dep_update_scan": false,
  "mutation_scan": false,
  "mutation_targets": [],
  "patrol_schedule": "",
  "patrol_auto_ideas": false,
  "research_schedule": "",
  "usage_provider": "claude",
  "minimax_api_key": "",
  "minimax_group_id": "",
  "parallel_fix_samples": 3,
  "oracle_max_reject_rounds": 5,
  "oracle_verdict_samples": 1,
  "auto_classify_retry": false,
  "auto_classify_retry_max": 2,
  "auto_classify_retry_model_fallback": {
    "opus": "sonnet",
    "sonnet": "haiku"
  },
  "worker_fallback_model": "",
  "context_span_budget": 6000,
  "task_type_model_routing": {},
  "task_class_resampling": {},
  "replay_interrupted_on_startup": false,
  "execution_backend": "local",
  "agent_runtime": "claude",
  "runtime_connections": {
    "claude": "claude-default",
    "codex": "codex-default"
  },
  "connections": {
    "claude-default": {
      "agent_runtime": "claude",
      "inference_provider": "runtime-default",
      "wire_protocol": "runtime-native",
      "endpoint_identity": "claude-user-config",
      "models": {},
      "capabilities": {}
    },
    "codex-default": {
      "agent_runtime": "codex",
      "inference_provider": "runtime-default",
      "wire_protocol": "runtime-native",
      "endpoint_identity": "codex-user-config",
      "models": {},
      "capabilities": {}
    }
  },
  "codex_cheap_model": "gpt-5.6-terra",
  "codex_strong_model": "gpt-5.6-sol",
  "usage_poll_enabled": true,
  "usage_poll_interval_sec": 900,
  "usage_poll_since_days": 7,
  "usage_hub_url": "",
  "usage_hub_token": "",
  "usage_ingest_token": "",
  "hydration_distillation": false,
  "reactions_enabled": true,
  "reaction_configs": [
    {
      "name": "repeated_tool_failure",
      "event_type": "error",
      "event_match": "(?:tool|command).*failed|exit code [1-9]",
      "threshold": 3,
      "window_seconds": 300,
      "action": "escalate",
      "action_payload": {
        "strategy": "suggest_alternative"
      }
    },
    {
      "name": "same_tool_repeated",
      "event_type": "tool_call",
      "event_match": "^(?:bash|shell|exec):",
      "threshold": 5,
      "window_seconds": 180,
      "action": "warn",
      "action_payload": {
        "message": "Same tool called 5+ times — consider alternative approach"
      }
    },
    {
      "name": "loop_detected",
      "event_type": "state_change",
      "event_match": "loop.*detected",
      "threshold": 1,
      "window_seconds": 0,
      "action": "abort",
      "action_payload": {
        "message": "Behavioral loop detected — aborting task"
      }
    }
  ]
}
